<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>FairPlay URL Player Test</title>
    <style>
        body { background: #000; color: #0f0; font-family: monospace; padding: 20px; }
        video { width: 960px; height: 540px; background: #111; }
        #log { white-space: pre-wrap; font-size: 12px; max-height: 400px; overflow-y: auto; margin-top: 10px; }
        .error { color: #f00; }
        .warn { color: #ff0; }
        .ok { color: #0f0; }
    </style>
</head>
<body>
    <h3>FairPlay DRM + URL Player (AVPlayer) Test</h3>
    <video id="video" autoplay controls muted></video>
    <div id="log"></div>

    <script>
    // Axinom FairPlay test configuration
    var CONFIG = {
        // FairPlay-encrypted HLS stream (CBCS)
        streamUrl: 'https://media.axprod.net/TestVectors/Cmaf/protected_1080p_h264_cbcs/manifest.m3u8',

        // Axinom FairPlay license server + JWT token
        licenseUrl: 'https://drm-fairplay-licensing.axprod.net/AcquireLicense',
        licenseToken: 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..NL2btcHvRpeZGnJXrOdyNbNZOLl7Osl9TlGPlb-3a60',

        // FairPlay certificate (embedded to avoid network fetch issues)
        // Original URL: https://tools.axinom.com/FPScert/fairplay.cer
        certificateBase64: '',

        // Key system identifiers to try
        keySystems: ['com.youtube.fairplay', 'com.apple.fps', 'com.apple.fps.1_0', 'com.apple.fps.2_0']
    };

    var logEl = document.getElementById('log');
    function log(msg, cls) {
        var line = '[' + new Date().toISOString().substr(11, 12) + '] ' + msg;
        console.log(line);
        var span = document.createElement('span');
        span.className = cls || '';
        span.textContent = line + '\n';
        logEl.appendChild(span);
        logEl.scrollTop = logEl.scrollHeight;
    }

    var video = document.getElementById('video');
    var certificate = null;
    var keySystemUsed = null;

    // Step 1: Set src to trigger URL player path
    log('Setting video.src to FairPlay HLS stream...', 'ok');
    log('URL: ' + CONFIG.streamUrl);
    video.src = CONFIG.streamUrl;

    // Queued encrypted events to process after EME setup
    var pendingEncryptedEvents = [];
    var mediaKeys = null;
    var emeSetupStarted = false;
    var emeSetupDone = false;

    // Step 2: Listen for events that signal encrypted content
    video.addEventListener('encrypted', function(event) {
        log('EVENT: encrypted - initDataType=' + event.initDataType +
            ' initData.byteLength=' + (event.initData ? event.initData.byteLength : 'null'), 'ok');
        if (emeSetupDone && mediaKeys) {
            handleEncryptedEvent(event);
        } else {
            pendingEncryptedEvents.push(event);
            setupEME();
        }
    });

    video.addEventListener('waitingforkey', function(event) {
        log('EVENT: waitingforkey - CDM needed!', 'warn');
        setupEME();
    });

    // Also try proactive EME setup after a short delay
    setTimeout(function() {
        if (!keySystemUsed) {
            log('Timeout: attempting proactive EME setup...', 'warn');
            setupEME();
        }
    }, 3000);

    // Monitor video state
    video.addEventListener('loadstart', function() { log('EVENT: loadstart'); });
    video.addEventListener('loadedmetadata', function() { log('EVENT: loadedmetadata'); });
    video.addEventListener('canplay', function() { log('EVENT: canplay', 'ok'); });
    video.addEventListener('playing', function() { log('EVENT: playing', 'ok'); });
    video.addEventListener('error', function() {
        var e = video.error;
        log('EVENT: error - code=' + (e ? e.code : '?') + ' message=' + (e ? e.message : '?'), 'error');
    });
    video.addEventListener('stalled', function() { log('EVENT: stalled', 'warn'); });
    video.addEventListener('waiting', function() { log('EVENT: waiting'); });

    // Handle a single encrypted event: create session, generate request,
    // fetch license, update session.
    async function handleEncryptedEvent(event) {
        try {
            log('Creating MediaKeySession for initDataType=' + event.initDataType, 'ok');
            var session = mediaKeys.createSession();

            session.addEventListener('message', async function(msgEvent) {
                log('SESSION message: type=' + msgEvent.messageType +
                    ' byteLength=' + msgEvent.message.byteLength, 'ok');

                // Send SPC (Server Playback Context) to license server
                var licenseUrl = CONFIG.licenseUrl + '?AxDrmMessage=' + CONFIG.licenseToken;
                log('Sending license request to: ' + CONFIG.licenseUrl);

                try {
                    var response = await fetch(licenseUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/octet-stream' },
                        body: msgEvent.message
                    });

                    if (!response.ok) {
                        log('License server error: ' + response.status + ' ' + response.statusText, 'error');
                        var body = await response.text();
                        log('Response body: ' + body.substring(0, 200), 'error');
                        return;
                    }

                    var licenseData = await response.arrayBuffer();
                    log('License received, size=' + licenseData.byteLength + ' bytes', 'ok');

                    await session.update(new Uint8Array(licenseData));
                    log('Session updated with license - key should be active!', 'ok');
                } catch (fetchErr) {
                    log('License fetch error: ' + fetchErr.message, 'error');
                }
            });

            session.addEventListener('keystatuseschange', function() {
                log('SESSION keystatuseschange:', 'ok');
                session.keyStatuses.forEach(function(status, keyId) {
                    var keyIdHex = Array.from(new Uint8Array(keyId))
                        .map(function(b) { return b.toString(16).padStart(2, '0'); }).join('');
                    log('  Key ' + keyIdHex + ' status=' + status,
                        status === 'usable' ? 'ok' : 'warn');
                });
            });

            // Generate the key request with the init data from the encrypted event
            log('Calling session.generateRequest(' + event.initDataType + ', initData)...');
            await session.generateRequest(event.initDataType, event.initData);
            log('generateRequest completed', 'ok');

        } catch (error) {
            log('handleEncryptedEvent error: ' + error.message, 'error');
            log('Stack: ' + error.stack, 'error');
        }
    }

    async function setupEME() {
        if (emeSetupStarted) return;
        emeSetupStarted = true;
        log('--- EME Setup Starting ---', 'ok');

        try {
            // Decode embedded FairPlay certificate (avoids network fetch issues)
            log('Decoding embedded FairPlay certificate...');
            var certBinary = atob(CONFIG.certificateBase64);
            certificate = new ArrayBuffer(certBinary.length);
            var certView = new Uint8Array(certificate);
            for (var j = 0; j < certBinary.length; j++) {
                certView[j] = certBinary.charCodeAt(j);
            }
            log('Certificate decoded, size=' + certificate.byteLength + ' bytes', 'ok');

            // Try each key system
            var access = null;
            for (var i = 0; i < CONFIG.keySystems.length; i++) {
                var ks = CONFIG.keySystems[i];
                try {
                    log('Trying requestMediaKeySystemAccess("' + ks + '")...');
                    access = await navigator.requestMediaKeySystemAccess(ks, [{
                        initDataTypes: ['skd', 'sinf', 'cenc'],
                        videoCapabilities: [{
                            contentType: 'video/mp4; codecs="avc1.42E01E"'
                        }],
                        audioCapabilities: [{
                            contentType: 'audio/mp4; codecs="mp4a.40.2"'
                        }]
                    }]);
                    keySystemUsed = ks;
                    log('Key system accepted: ' + ks, 'ok');
                    break;
                } catch (e) {
                    log('Key system "' + ks + '" not supported: ' + e.message, 'warn');
                }
            }

            if (!access) {
                log('No supported FairPlay key system found!', 'error');
                return;
            }

            // Create MediaKeys
            log('Creating MediaKeys...');
            mediaKeys = await access.createMediaKeys();
            log('MediaKeys created', 'ok');

            // Set server certificate
            log('Setting server certificate...');
            var certSet = await mediaKeys.setServerCertificate(new Uint8Array(certificate));
            log('Server certificate set: ' + certSet, 'ok');

            // Attach to video element (this triggers SetCdm in StarboardRenderer)
            log('Calling video.setMediaKeys()... (triggers SetCdm -> SetDrmSystem)');
            await video.setMediaKeys(mediaKeys);
            log('MediaKeys attached to video element!', 'ok');

            emeSetupDone = true;
            log('--- EME Setup Complete ---', 'ok');

            // Process any queued encrypted events
            if (pendingEncryptedEvents.length > 0) {
                log('Processing ' + pendingEncryptedEvents.length + ' queued encrypted event(s)...');
                for (var i = 0; i < pendingEncryptedEvents.length; i++) {
                    await handleEncryptedEvent(pendingEncryptedEvents[i]);
                }
                pendingEncryptedEvents = [];
            }

        } catch (error) {
            log('EME Setup Error: ' + error.message, 'error');
            log('Stack: ' + error.stack, 'error');
        }
    }

    // Periodic status report
    setInterval(function() {
        if (video.readyState >= 1) {
            log('Status: time=' + video.currentTime.toFixed(1) +
                ' duration=' + (isFinite(video.duration) ? video.duration.toFixed(1) : 'N/A') +
                ' paused=' + video.paused +
                ' readyState=' + video.readyState +
                ' networkState=' + video.networkState);
        }
    }, 5000);
    </script>
</body>
</html>

